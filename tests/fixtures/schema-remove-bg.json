{
  "endpoint_id": "fal-ai/ideogram/remove-background",
  "category": "image-to-image",
  "documentation_url": "https://fal.ai/models/fal-ai/ideogram/remove-background/api",
  "playground_url": "https://fal.ai/models/fal-ai/ideogram/remove-background",
  "input": {
    "properties": {
      "image_url": {
        "examples": [
          "https://v3.fal.media/files/rabbit/F6dvKPFL9VzKiM8asJOgm_MJj6yUB6rGjTsv_1YHIcA_image.webp"
        ],
        "type": "string",
        "description": "The image URL whose background needs to be removed. The foreground subject is preserved against a transparent background. JPEG, PNG and WebP formats are supported (maximum file size 10MB)."
      },
      "sync_mode": {
        "type": "boolean",
        "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
        "default": false
      }
    },
    "type": "object",
    "required": [
      "image_url"
    ],
    "x-fal-order-properties": [
      "image_url",
      "sync_mode"
    ]
  },
  "output": {
    "properties": {
      "image": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "type": [
              "string",
              "null"
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "type": [
              "string",
              "null"
            ]
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "examples": [
          {
            "url": "https://v3b.fal.media/files/b/0a994215/rxdZME1tH4a2pmk0sKV-x_image.png"
          }
        ],
        "description": "The foreground image with the background removed (transparent)."
      }
    },
    "type": "object",
    "required": [
      "image"
    ],
    "x-fal-order-properties": [
      "image"
    ]
  }
}
